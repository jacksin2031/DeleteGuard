<?xml version="1.0" encoding="utf-8"?>
<WixLocalization Culture="ko-KR" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="LCID" Value="1042" />
  <String Id="ProductName" Value="DeleteGuard" />
  <String Id="Manufacturer" Value="DeleteGuard contributors" />
  <String Id="Description" Value="NTFS 폴더를 위한 관리자 승인 기반 삭제 보호" />
  <String Id="DowngradeError" Value="더 최신 버전의 DeleteGuard가 이미 설치되어 있습니다." />
  <String Id="ShortcutDescription" Value="DeleteGuard 관리 창 열기" />
  <String Id="FeatureMainTitle" Value="DeleteGuard" />
  <String Id="FeatureMainDescription" Value="DeleteGuard 명령줄 도구, 권한 상승 Broker, 트레이 Agent 및 이들에 필요한 .NET 런타임입니다. 파일 시스템 드라이버는 포함되지 않습니다." />
  <String Id="FeaturePathTitle" Value="PATH에 추가" />
  <String Id="FeaturePathDescription" Value="모든 터미널에서 &quot;deleteguard&quot;를 실행할 수 있습니다." />
  <String Id="FeatureShortcutTitle" Value="시작 메뉴 바로 가기" />
  <String Id="FeatureShortcutDescription" Value="DeleteGuard 관리 창의 시작 메뉴 바로 가기를 추가합니다." />
  <String Id="FeatureAutoStartTitle" Value="Windows와 함께 시작" />
  <String Id="FeatureAutoStartDescription" Value="어떤 사용자든 로그인하면 DeleteGuard 트레이 Agent를 백그라운드로 시작합니다." />
  <String Id="ExitNote" Value="DeleteGuard를 제거하기 전에 폴더의 보호를 해제하세요(deleteguard unprotect &lt;path&gt; 또는 관리 창). 제거해도 폴더의 보호는 해제되지 않으며, 이후에는 일반 도구로 해당 폴더의 내용을 삭제할 수 없게 됩니다." />
</WixLocalization>
